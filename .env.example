# Copy this file to .env and adjust if needed.
# For the new deployment checklist see docs/PRODUCTION-DB.md (§ النشر الجديد).

# ── Local development (SQLite) ──
# Path is resolved relative to prisma/schema.prisma
DATABASE_URL=file:../db/custom.db

# ── Production (PostgreSQL on Vercel — REQUIRED, see docs/PRODUCTION-DB.md) ──
# Neon pooled / Supabase transaction-pooler (6543) / Vercel Postgres
# DATABASE_URL=postgresql://user:password@host:6543/nokhba?sslmode=require&pgbouncer=true&connection_limit=1

# ── Production optional ──
# Public site URL (canonical/SEO + sitemap) — set to the NEW deployment domain
# NEXT_PUBLIC_SITE_URL=https://your-new-domain
# Google Search Console verification token (meta tag)
# GOOGLE_SITE_VERIFICATION=
# HMAC secret for room PIN / anti-cheat check-in (defaults to a dev constant —
# set a strong random value in production; changing it only invalidates in-flight PINs)
# NOKHBA_PV_SECRET=<random-64-chars>

# ── Zaki agent (all OPTIONAL — saved Center settings in the DB take priority) ──
# Brain LLM (Groq): env wins over Center settings if present
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_MODEL=openai/gpt-oss-120b
# AGENT_LLM_API_KEY=gsk_...
# Speech-to-text (Groq Whisper):
# AGENT_STT_PROVIDER=groq
# AGENT_STT_BASE_URL=https://api.groq.com/openai/v1
# AGENT_STT_API_KEY=gsk_...
# AGENT_STT_MODEL=whisper-large-v3-turbo
# AGENT_STT_PROMPT=مصطلحات السنتر: زكي، النخبة، حضور، مجموعات، فودافون كاش

# ── Testing / ops toggles (never set in production) ──
# NK_AGENT_BRAIN_FIRST=1   # deterministic brain-first routing (used by e2e suite)
# NK_RATELIMIT_OFF=1       # disable rate limits (load tests only)
# NK_AGENT_DEBUG=1         # log raw model replies
# NK_DB_CONNECTION_LIMIT=5 # cap Prisma pool size
